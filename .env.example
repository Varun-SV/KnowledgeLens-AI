# Trusted local/self-hosted deployments only.
# Enables localhost / 127.0.0.1 endpoints such as Ollama and llama.cpp.
KNOWLEDGELENS_ALLOW_LOCAL_ENDPOINTS=1

# Optional. Only enable when KnowledgeLens itself runs inside a trusted private network
# and intentionally needs to reach RFC1918/private LLM endpoints.
# KNOWLEDGELENS_ALLOW_PRIVATE_ENDPOINTS=1
