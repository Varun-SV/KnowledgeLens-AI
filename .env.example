# Deployment policy: local, private, or public.
KNOWLEDGELENS_DEPLOYMENT_MODE=local

# PostgreSQL persistence. When omitted/unavailable, the app remains usable with
# legacy in-session provider settings so a database outage does not brick startup.
# KNOWLEDGELENS_DATABASE_URL=postgresql://knowledgelens:change-me@localhost:5432/knowledgelens
# KNOWLEDGELENS_DATABASE_CONNECT_TIMEOUT=5

# Default local SHA-256 content store.
# KNOWLEDGELENS_BLOB_ROOT=./data/blobs

# Server-side encrypted-secret fallback. Use a strong random value (32+ characters).
# Desktop/local installs prefer the OS keychain.
# KNOWLEDGELENS_MASTER_KEY=replace-with-a-long-random-server-secret

# Authentication foundation. Full public-session enforcement/OIDC UI lands later.
# Options: disabled, local, oidc
KNOWLEDGELENS_AUTH_MODE=disabled
# KNOWLEDGELENS_OIDC_ISSUER=https://login.example.com/realms/knowledge
# KNOWLEDGELENS_OIDC_CLIENT_ID=knowledgelens
# KNOWLEDGELENS_OIDC_SCOPES=openid profile email

# Trusted local/self-hosted deployments only.
KNOWLEDGELENS_ALLOW_LOCAL_ENDPOINTS=1

# Legacy compatibility endpoint. PostgreSQL-backed provider profiles are preferred
# and can be activated from the UI without restarting KnowledgeLens.
# KNOWLEDGELENS_CUSTOM_ENDPOINT=https://llm.example.com

# Optional. Only enable when KnowledgeLens intentionally needs private-network endpoints.
# KNOWLEDGELENS_ALLOW_PRIVATE_ENDPOINTS=1
